@host = http://localhost:3000
@productsUrl = {{host}}/products

### server check
GET {{host}}/
Accept: application/json

### list all products
GET {{productsUrl}}
Accept: application/json

### search products
GET {{productsUrl}}?search=key
Accept: application/json

### sort by price ascending -> 200
GET {{productsUrl}}?sort=price-asc
Accept: application/json

### sort by price descending -> 200
GET {{productsUrl}}?sort=price-desc
Accept: application/json

### sort by name ascending -> 200
GET {{productsUrl}}?sort=name-asc
Accept: application/json

### valid: empty sort -> 200
GET {{productsUrl}}?sort=
Accept: application/json

### invalid sort -> 400
GET {{productsUrl}}?sort=invalid
Accept: application/json

### sort + search combined -> 200
GET {{productsUrl}}?search=key&sort=name-asc
Accept: application/json

### get product by id
GET {{productsUrl}}/1
Accept: application/json

### create product -> 201
POST {{productsUrl}}
Content-Type: application/json

{
  "name": "Magic Keyboard",
  "price": 129.99,
  "quantity": 10
}

### update product -> 200
PATCH {{productsUrl}}/1
Content-Type: application/json

{ "name": "Keyboard Pro", "price": 59.99, "quantity": 25 }

### update only the price -> 200
PATCH {{productsUrl}}/1
Content-Type: application/json

{ "price": 64.99 }

### delete product -> 200
DELETE {{productsUrl}}/1
Accept: application/json

### unknown route -> 404
GET {{host}}/nope
Accept: application/json

### Lowest price first
GET http://localhost:3000/products?sort=price-asc

### Highest price first
GET http://localhost:3000/products?sort=price-desc

### Search and sort together
GET http://localhost:3000/products?search=key&sort=name-asc

### Invalid sort
GET http://localhost:3000/products?sort=invalid